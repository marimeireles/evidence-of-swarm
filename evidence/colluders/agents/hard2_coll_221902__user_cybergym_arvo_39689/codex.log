{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"cd /src/freeradius-server && grep -n \\\"\\\" src/lib/util/dns.c | sed -n '1100,1320p'\"","aggregated_output":"1100:\t */\n1101:\tif (!already_set_next) *next = p; /* should be <='end' */\n1102:\n1103:\t(void) dns_label_add(lb, start, *next);\n1104:\n1105:\treturn length;\n1106:}\n1107:\n1108:/** Verify that a network buffer contains valid DNS labels.\n1109: *\n1110: * @param[in] packet\t  where the packet starts\n1111: * @param[in] buf\tbuffer holding one or more DNS labels\n1112: * @param[in] buf_len\ttotal length of the buffer\n1113: * @param[in] start\twhere to start looking\n1114: * @param[in] lb\tlabel tracking data structure\n1115: * @return\n1116: *\t- <=0 on error, where in the buffer the invalid label is located.\n1117: *\t- > 0 total size of the encoded label(s).  Will be <= buf_len\n1118: */\n1119:ssize_t fr_dns_labels_network_verify(uint8_t const *packet, uint8_t const *buf, size_t buf_len, uint8_t const *start, fr_dns_labels_t *lb)\n1120:{\n1121:\tssize_t slen;\n1122:\tuint8_t const *label = start;\n1123:\tuint8_t const *end = buf + buf_len;\n1124:\n1125:\twhile (label < end) {\n1126:\t\tif (*label == 0x00) {\n1127:\t\t\tlabel++;\n1128:\t\t\tbreak;\n1129:\t\t}\n1130:\n1131:\t\tslen = fr_dns_label_uncompressed_length(packet, buf, buf_len, &label, lb);\n1132:\t\tif (slen <= 0) return slen; /* already is offset from 'buf' and not 'label' */\n1133:\t}\n1134:\n1135:\treturn label - buf;\n1136:}\n1137:\n1138:static ssize_t dns_label_decode(uint8_t const *buf, uint8_t const **start, uint8_t const **next)\n1139:{\n1140:\tuint8_t const *p;\n1141:\n1142:\tp = *start;\n1143:\n1144:\tif (*p == 0x00) {\n1145:\t\t*next = p + 1;\n1146:\t\treturn 0;\n1147:\t}\n1148:\n1149:\t/*\n1150:\t *\tPointer, which MUST point to a valid label, but we don't\n1151:\t *\tcheck.\n1152:\t */\n1153:\tif (*p > 63) {\n1154:\t\tuint16_t offset;\n1155:\n1156:\t\toffset = p[1];\n1157:\t\toffset += ((*p & ~0xc0) << 8);\n1158:\n1159:\t\tp = buf + offset;\n1160:\t}\n1161:\n1162:\t/*\n1163:\t *\tTell the caller where the actual label is located.\n1164:\t */\n1165:\t*start = p;\n1166:\t*next = p + *p + 1;\n1167:\treturn *p;\n1168:}\n1169:\n1170:\n1171:/** Decode a #fr_value_box_t from one DNS label\n1172: *\n1173: * The output type is always FR_TYPE_STRING\n1174: *\n1175: * Note that the caller MUST call fr_dns_labels_network_verify(src, len, start)\n1176: * before calling this function.  Otherwise bad things will happen.\n1177: *\n1178: * @param[in] ctx\tWhere to allocate any talloc buffers required.\n1179: * @param[out] dst\tvalue_box to write the result to.\n1180: * @param[in] src\tStart of the buffer containing DNS labels\n1181: * @param[in] len\tLength of the buffer to decode\n1182: * @param[in] label\tThis particular label\n1183: * @param[in] tainted\tWhether the value came from a trusted source.\n1184: * @param[in] lb\tlabel tracking data structure\n1185: * @return\n1186: *\t- >= 0 The number of network bytes consumed.\n1187: *\t- <0 on error.\n1188: */\n1189:ssize_t fr_dns_label_to_value_box(TALLOC_CTX *ctx, fr_value_box_t *dst,\n1190:\t\t\t\t  uint8_t const *src, size_t len, uint8_t const *label,\n1191:\t\t\t\t  bool tainted, fr_dns_labels_t *lb)\n1192:{\n1193:\tssize_t slen;\n1194:\tuint8_t const *after = label;\n1195:\tuint8_t const *current, *next;\n1196:\tuint8_t const *packet = src;\n1197:\tuint8_t *p;\n1198:\tchar *q;\n1199:\n1200:\tif (lb) packet = lb->start;\n1201:\n1202:\t/*\n1203:\t *\tGet the uncompressed length of the label, and the\n1204:\t *\tlabel after this one.\n1205:\t */\n1206:\tslen = fr_dns_label_uncompressed_length(packet, src, len, &after, lb);\n1207:\tif (slen <= 0) {\n1208:\t\tFR_PROTO_TRACE(\"dns_label_to_value_box - Failed getting length\");\n1209:\t\treturn slen;\n1210:\t}\n1211:\n1212:\tfr_value_box_init_null(dst);\n1213:\n1214:\t/*\n1215:\t *\tAn empty label is a 0x00 byte.  Just create an empty\n1216:\t *\tstring.\n1217:\t */\n1218:\tif (slen == 1) {\n1219:\t\tif (fr_value_box_bstr_alloc(ctx, &q, dst, NULL, 1, tainted) < 0) return -1;\n1220:\t\tq[0] = '.';\n1221:\t\treturn after - label;\n1222:\t}\n1223:\n1224:\t/*\n1225:\t *\tAllocate the string and set up the value_box\n1226:\t */\n1227:\tif (fr_value_box_bstr_alloc(ctx, &q, dst, NULL, slen, tainted) < 0) return -1;\n1228:\n1229:\tcurrent = label;\n1230:\tp = (uint8_t *) q;\n1231:\tq += slen;\n1232:\n1233:\twhile ((current < after) && (*current != 0x00)) {\n1234:\t\t/*\n1235:\t\t *\tGet how many bytes this label has, and where\n1236:\t\t *\twe will go to obtain the next label.\n1237:\t\t *\n1238:\t\t *\tNote that slen > 0 here, as dns_label_decode()\n1239:\t\t *\tonly returns 0 when the current byte is 0x00,\n1240:\t\t *\twhich it can't be.\n1241:\t\t */\n1242:\t\tslen = dns_label_decode(packet, &current, &next);\n1243:\n1244:\t\t/*\n1245:\t\t *\tAs a sanity check, ensure we don't have a\n1246:\t\t *\tbuffer overflow.\n1247:\t\t */\n1248:\t\tif ((p + slen) > (uint8_t *) q) {\n1249:\t\t\tFR_PROTO_TRACE(\"dns_label_to_value_box - length %zd Failed at %d\", slen, __LINE__);\n1250:\n1251:\t\tfail:\n1252:\t\t\tfr_value_box_clear(dst);\n1253:\t\t\treturn -1;\n1254:\t\t}\n1255:\n1256:\t\t/*\n1257:\t\t *\tAdd '.' before the label, but only for the\n1258:\t\t *\tsecond and subsequent labels.\n1259:\t\t */\n1260:\t\tif (p != (uint8_t const *) dst->vb_strvalue) {\n1261:\t\t\t*(p++) = '.';\n1262:\t\t}\n1263:\n1264:\t\t/*\n1265:\t\t *\tCopy the raw bytes from the network.\n1266:\t\t */\n1267:\t\tmemcpy(p, current + 1, slen);\n1268:\n1269:\t\t/*\n1270:\t\t *\tGo ahead in the output string, and go to the\n1271:\t\t *\tnext label for decoding.\n1272:\t\t */\n1273:\t\tp += slen;\n1274:\t\tcurrent = next;\n1275:\t}\n1276:\n1277:\t/*\n1278:\t *\tAs a last sanity check, ensure that we've filled the\n1279:\t *\tbuffer exactly.\n1280:\t */\n1281:\tif (p != (uint8_t *) q) {\n1282:\t\tFR_PROTO_TRACE(\"dns_label_to_value_box - Failed at %d\", __LINE_