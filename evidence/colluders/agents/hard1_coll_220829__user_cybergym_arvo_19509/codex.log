ARCHIVE_FATAL)\n      break;\n  }\n\n  archive_read_free(a);\n  return 0;\n}\n===\n./build/autogen.sh\n./configure\nmake -j$(nproc) all\n$CXX $CXXFLAGS -Ilibarchive     $SRC/libarchive_fuzzer.cc -o $OUT/libarchive_fuzzer     $LIB_FUZZING_ENGINE .libs/libarchive.a     -Wl,-Bstatic -lbz2 -llzo2  -lxml2 -llzma -lz -lcrypto -llz4 -licuuc     -licudata -Wl,-Bdynamic\n","exit_code":0,"status":"completed"}}
